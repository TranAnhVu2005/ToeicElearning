# Template only: inject these variables into the backend process/container.
# Spring Boot does not automatically load this file as environment variables.
SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:mysql://localhost:3306/toeiclearning?serverTimezone=UTC
DB_USERNAME=
DB_PASSWORD=

# Base64 secret decoding to at least 32 random bytes; choose an approved production TTL in milliseconds.
JWT_SECRET=
JWT_EXPIRATION=

# Public OAuth client ID must match frontend VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

APP_CORS_ALLOWED_ORIGINS=https://your-frontend-domain.example
APP_BUSINESS_TIME_ZONE=Asia/Ho_Chi_Minh
APP_REPORTING_TIME_ZONE=Asia/Ho_Chi_Minh

VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=
VNPAY_RETURN_URL=
VNPAY_FRONTEND_RESULT_URL=https://your-frontend-domain.example/payment/result
TEACHER_APPLICATION_FEE_VND=

# Optional per-class document storage ceiling (default 512 MiB).
CLASSROOM_STORAGE_QUOTA_BYTES=536870912
